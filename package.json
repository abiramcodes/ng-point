{
  "name": "ng-point-workspace",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve demo",
    "build": "ng build demo",
    "build:lib": "ng build ng-point",
    "watch": "ng build demo --watch --configuration development",
    "test": "ng test demo",
    "test:lib": "ng test ng-point",
    "test:all": "ng test demo && ng test ng-point",
    "publish:lib": "pnpm build:lib && npm publish ./dist/ng-point",
    "check:prod": "ng build demo --configuration production && node scripts/check-prod-clean.mjs"
  },
  "packageManager": "pnpm@12.14.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.0",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^30.0.0",
    "ng-packagr": "^22.2.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
